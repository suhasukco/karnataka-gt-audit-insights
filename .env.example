# Copy to .env at the repo root and fill in your real local Postgres credentials.
# database/, etl/, and apps/api all read this same file (python-dotenv walks up
# from the current working directory to find it).

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/karnataka_gt

# Where the real 100-column outlet export lives. Defaults to etl/data/raw/gt_outlets.xlsx
# if unset.
# Use forward slashes even on Windows — dotenv treats backslash sequences like
# \r and \t as escape codes and will silently corrupt a Windows-style path.
RAW_FILE_PATH=D:/GTA Data/retailer_export_20260706.xlsx
